{
  "name": "suikan-statistics-cloudflare",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "assets": "node prepare-assets.mjs",
    "predev": "npm run assets",
    "dev": "wrangler dev --config wrangler.example.json --ip 127.0.0.1 --port 18771",
    "pretest": "npm run assets",
    "test": "node --test tests/worker.test.mjs",
    "predeploy": "npm run assets",
    "deploy": "wrangler deploy --config wrangler.json",
    "check": "npm run assets && wrangler deploy --config wrangler.example.json --dry-run --outdir .local/bundle"
  },
  "devDependencies": { "wrangler": "4.149.0", "miniflare": "5.20261006.1-alpha" }
}
